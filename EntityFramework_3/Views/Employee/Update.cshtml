@model EntityFramework_3.Models.Employee

<h1>Update</h1>

@using (Html.BeginForm())
{
    <div class="form-horizontal">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.eno, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.eno, new { htmlAttributes = new { @class = "form-contro", @readonly = true, @disabled = true } })
            @Html.ValidationMessageFor(model => model.eno, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ename, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.ename, new { htmlAttributes = new { @class = "form-contro" } })
            @Html.ValidationMessageFor(model => model.ename, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.job, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.job, new { htmlAttributes = new { @class = "form-contro" } })
            @Html.ValidationMessageFor(model => model.job, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.salary, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.salary, new { htmlAttributes = new { @class = "form-contro" } })
            @Html.ValidationMessageFor(model => model.salary, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.deptno, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.deptno, new { htmlAttributes = new { @class = "form-contro" } })
            @Html.ValidationMessageFor(model => model.deptno, "", new { @class = "text-danger" })
        </div>
        <div>
            <input type="submit" value="Update" class="btn btn-primary" />
        </div>
    </div>
}

<div>
    <p> @Html.ActionLink("Back to Employees list", "Read")</p>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}