
<style>
    .even {
        color: green;
        margin: 0 10px;
    }

    .odd {
        color: red;
        margin: 0 10px;
    }
</style>


<h2>PrintNumbers</h2>

@for (int i = 1; i <= 10; i++)
{
    if (i % 2 == 0)
    {
        <span class="even">@i</span>
    }
    else
    {
        <span class="odd">@i</span>
    }
}


